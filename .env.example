# BlackEye — Environment Configuration
# Copy this file to .env and fill in your values, OR export the variables in your shell / systemd service.
# Never commit the real .env file to Git — it is already in .gitignore.

# ── Telegram ──────────────────────────────────────────────────────────────────
# Get your bot token from @BotFather on Telegram
BLACKEYE_TELEGRAM_TOKEN=your_bot_token_here

# Your personal Telegram numeric chat ID (use @userinfobot to find it)
BLACKEYE_TELEGRAM_CHAT_ID=your_chat_id_here
